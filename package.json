{
  "name": "sane-kit",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "format": "prettier --write .",
    "typegen": "pnpm --filter studio typegen",
    "deploy:studio": "pnpm --filter studio deploy",
    "validate": "sanity-template-validate",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@sanity/template-validator": "^3.1.1",
    "prettier": "^3.5.3",
    "turbo": "^2.11.7"
  }
}
