{
  "name": "sane-kit",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "pnpm --filter studio typegen",
    "deploy:studio": "pnpm --filter studio deploy",
    "validate": "sanity-template-validate",
    "typecheck:blueprint": "tsc --noEmit",
    "blueprint:plan": "sanity blueprints plan",
    "blueprint:deploy": "sanity blueprints deploy",
    "verify": "pnpm typecheck && pnpm typecheck:blueprint && pnpm lint && pnpm format:check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.28.0",
    "@sanity/client": "^8.9.0",
    "@sanity/functions": "^1.8.1",
    "@sanity/template-validator": "^3.1.1",
    "@types/node": "^24.19.1",
    "prettier": "^3.5.3",
    "sanity": "^6.18.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
