# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# turbo
.turbo

# Also ignore node_modules in sub-projects
/frontend/node_modules
/studio/node_modules

# misc
.DS_Store
*.pem
/studio/dist
/studio/.sanity
/.sanity

# sanity functions (local dev/test artifacts)
/functions/**/.build
/functions/**/node_modules
/functions/**/.env*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE - VS Code settings directory
/.vscode


# playwright
/frontend/test-results
/frontend/playwright-report
